---
layout: layouts/base.njk
title: Home
description: Preeti Raghunath is a Lecturer in Digital Media and Society at the University of Sheffield, researching media and technology policy, AI governance, and data policy across the Global South.
---

<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>Preeti Raghunath</h1>
        <p class="hero-position">
          Lecturer in Digital Media and Society<br>
          University of Sheffield, UK
        </p>
        <a href="/assets/Preeti Raghunath - Full CV.pdf" class="cv-link" target="_blank" rel="noopener">Full CV (PDF)</a>
      </div>
      <div class="hero-image">
        <img src="/assets/images/profile.jpg" alt="Preeti Raghunath">
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>About</h2>
    </div>
    <div class="bio">
      {% for para in home.bio %}
        <p>{{ para | md | safe }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Work</h2>
    </div>
    <div class="role-cards">
      {% for tile in home.workTiles %}
        <a href="{{ tile.url }}" class="role-card">
          <h3>{{ tile.title }}</h3>
          <p>{{ tile.description }}</p>
          <span class="card-link">{{ tile.linkText }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Current Projects</h2>
    </div>
    <div>
      {% for project in home.currentProjects %}
        <div class="project-card">
          <h3>{{ project.title }}</h3>
          <p>{{ project.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Contact</h2>
    </div>
    <div class="contact-links">
      <a href="mailto:{{ site.email.work }}">{{ site.email.work }}</a>
      <a href="mailto:{{ site.email.personal }}">{{ site.email.personal }}</a>
    </div>
  </div>
</section>
