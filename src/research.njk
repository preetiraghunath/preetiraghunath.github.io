---
layout: layouts/base.njk
title: Research
description: Research areas, publications, and projects by Preeti Raghunath.
---

<section class="page-header">
  <div class="container">
    <span class="label">Academic</span>
    <h1>Research &amp; Publications</h1>
    <a href="/assets/Preeti Raghunath - Full CV.pdf" class="cv-link" target="_blank" rel="noopener">Full CV (PDF)</a>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Research Areas</h2>
    </div>
    <div class="tag-list">
      {% for area in research.researchAreas %}
        <span class="tag">{{ area }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Recent Publications</h2>
    </div>
    <div class="item-list">
      {% for pub in research.publications %}
        <div class="item">
          <p class="item-title">{{ pub.citation | md | safe }}</p>
          <p class="item-meta">{{ pub.type }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Monographs</h2>
    </div>
    <div class="item-list">
      {% for book in research.monographs %}
        <div class="item">
          <p class="item-title">
            {% if book.url %}
              <a href="{{ book.url }}" target="_blank" rel="noopener">{{ book.title }}</a>
            {% else %}
              {{ book.title }}
            {% endif %}
          </p>
          <p class="item-meta">{{ book.meta }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Edited Collections</h2>
    </div>
    <div class="item-list">
      {% for collection in research.editedCollections %}
        <div class="item">
          <p class="item-title">{{ collection.title }}</p>
          <p class="item-meta">{{ collection.meta }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Current Projects</h2>
    </div>
    <div>
      {% for project in research.currentProjects %}
        <div class="project-card">
          <h3>{{ project.title }}</h3>
          <p>{{ project.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Editorial Roles</h2>
    </div>
    <div class="item-list">
      {% for role in research.editorialRoles %}
        <div class="item">
          <p class="item-title">{{ role.title }}</p>
          <p class="item-meta">{{ role.role }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
