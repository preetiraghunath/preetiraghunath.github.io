---
layout: layouts/base.njk
title: Consulting
description: Research consulting services by Preeti Raghunath — policy, media, technology and governance.
---

<section class="page-header">
  <div class="container">
    <span class="label">Consulting</span>
    <h1>Research Consulting</h1>
    <p>Advisory and research services drawing on over a decade of expertise in media, technology policy and governance.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>What I Offer</h2>
    </div>
    <div class="bio">
      <p>{{ consulting.intro }}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Areas of Expertise</h2>
    </div>
    <div class="expertise-grid">
      {% for item in consulting.expertise %}
        <div class="expertise-item">
          <h3>{{ item.title }}</h3>
          <p>{{ item.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Previous Engagements</h2>
    </div>
    <div class="item-list">
      {% for engagement in consulting.engagements %}
        <div class="item">
          <p class="item-title">{{ engagement.title }}</p>
          <p class="item-meta">{{ engagement.meta }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <h2>Get in Touch</h2>
    </div>
    <div class="bio">
      <p>{{ consulting.contactText }}</p>
    </div>
    <div class="contact-links" style="margin-top: 1rem;">
      <a href="mailto:{{ site.email.work }}">{{ site.email.work }}</a>
      <a href="mailto:{{ site.email.personal }}">{{ site.email.personal }}</a>
    </div>
  </div>
</section>
