<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - {{ site.author }}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Base CSS -->
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">

    <!-- Page-specific CSS -->
    {% if roleType %}
    <link rel="stylesheet" href="{{ '/assets/css/role-pages.css' | url }}">
    {% else %}
    <link rel="stylesheet" href="{{ '/assets/css/homepage.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/tiles.css' | url }}">
    {% endif %}

    <!-- Modal CSS -->
    <link rel="stylesheet" href="{{ '/assets/css/modal.css' | url }}">

    <!-- SPA JavaScript Module -->
    <script type="module" src="{{ '/assets/js/app.js' | url }}"></script>
</head>
<body>
    {{ content | safe }}
</body>
</html>
